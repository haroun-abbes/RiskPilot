# Database. Default: SQLite file in RISKPILOT_DATA_DIR.
# PostgreSQL example: postgresql+psycopg://riskpilot:change-me@localhost:5432/riskpilot
DATABASE_URL=
# Where datasets (CSV) and the SQLite file are stored
RISKPILOT_DATA_DIR=./data
# Comma-separated origins allowed to call the API directly (the Next.js proxy does not need CORS)
CORS_ORIGINS=http://localhost:3000
# ECB Data Portal connector (public API, no key)
ENABLE_ECB_PROVIDER=true
ECB_BASE_URL=https://data-api.ecb.europa.eu/service/data
ECB_TIMEOUT_S=15
